CS_APP_NAME=Customer Service
CS_ENVIRONMENT=local

# The application and Alembic use this async SQLAlchemy URL.
# Fill in credentials locally; URL-encode special password characters.
CS_DATABASE_URL=
CS_DB_POOL_SIZE=5
CS_DB_MAX_OVERFLOW=10
CS_DB_POOL_TIMEOUT=30
CS_DB_POOL_RECYCLE=1800
CS_DB_POOL_PRE_PING=true

# PostgreSQL container settings for compose.yaml.
CS_POSTGRES_USER=
CS_POSTGRES_PASSWORD=
CS_POSTGRES_DB=
CS_POSTGRES_PORT=5432

# Integration tests must use a disposable PostgreSQL database.
CS_TEST_DATABASE_URL=

# Redis holds ephemeral coordination, rate limits and non-sensitive cache entries.
CS_REDIS_URL=redis://127.0.0.1:6379/0
CS_TEST_REDIS_URL=redis://127.0.0.1:6379/15
CS_REDIS_PORT=6379
CS_REDIS_MAX_CONNECTIONS=20
CS_REDIS_SOCKET_TIMEOUT=2
CS_REDIS_HEALTH_CHECK_INTERVAL=30
CS_REDIS_KEY_PREFIX=cs

# Enable LangGraph checkpoint table setup and its dedicated psycopg pool.
CS_CHECKPOINT_ENABLED=false
CS_CHECKPOINT_POOL_MIN_SIZE=1
CS_CHECKPOINT_POOL_MAX_SIZE=10
CS_CHECKPOINT_POOL_TIMEOUT=5

# HTTP chat is enabled when checkpointing and both model clients are configured.
# Identity is server controlled in local/test only; production needs real auth.
CS_DEV_USER_EXTERNAL_ID=local-demo-user
CS_DEFAULT_SNAPSHOT_ID=
CS_FACTS_DATABASE_PATH=
CS_LLM_API_KEY=
CS_LLM_BASE_URL=
CS_LLMA_MODEL=
CS_LLMB_MODEL=
CS_LLM_TIMEOUT=60
CS_ENABLE_MANUAL_SEARCH=false
# frozen_v1: 8 product-specific manuals; legacy_sqlite: old exact-bound category guidance.
CS_MANUAL_SOURCE=frozen_v1
